# Copy to .env and fill in. Never commit .env. Testnet only.

# Treasury that receives per-call HBAR payments, for example 0.0.123456
METER_TREASURY_ACCOUNT=
# Price per paid MCP tool call in tinybar (100000000 tinybar = 1 HBAR)
METER_PRICE_TINYBAR=10000
# HCS topic for usage receipts, for example 0.0.789012
HCS_RECEIPT_TOPIC_ID=

# Optional. When set, paid calls also submit a receipt to the HCS topic.
# When absent, receipts are logged and kept in memory only.
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=

# Optional mirror node override (testnet default is built in)
HEDERA_MIRROR_TESTNET_URL=https://testnet.mirrornode.hedera.com

# Frontend
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=
NEXT_PUBLIC_HEDERA_MAINNET_RPC_URL=
